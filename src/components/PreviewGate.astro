---
import Arrow from './Arrow.astro';

interface Props {
  passwordHash: string;
  title?: string;
}

const { passwordHash, title = 'Conscia Labs' } = Astro.props;
---

<section class="preview-gate" data-preview-gate data-password-hash={passwordHash} aria-labelledby="preview-gate-title">
  <div class="preview-gate__panel">
    <p class="section-label">Private preview</p>
    <h1 id="preview-gate-title">{title}</h1>
    <p class="preview-gate__intro">This page is being shared with invited reviewers. Enter the inspection password to continue.</p>
    <form class="preview-gate__form" data-preview-gate-form>
      <label class="sr-only" for="preview-password">Inspection password</label>
      <input id="preview-password" name="password" type="password" autocomplete="current-password" placeholder="Enter password" required />
      <button class="button button--primary" type="submit">Unlock preview <Arrow /></button>
    </form>
    <p class="preview-gate__error" data-preview-gate-error role="alert" hidden>That password doesn’t match. Try again.</p>
    <p class="preview-gate__note">Temporary access for Conscia Labs collaborators.</p>
    <a class="inline-link inline-link--light" href="/">Back to Conscia Labs <Arrow /></a>
  </div>
</section>

<script is:inline>
  (() => {
    const initialisePreviewGate = () => {
      const gate = document.querySelector('[data-preview-gate]');
      const form = gate?.querySelector('[data-preview-gate-form]');
      const input = gate?.querySelector('#preview-password');
      const error = gate?.querySelector('[data-preview-gate-error]');
      const content = document.querySelector('[data-preview-content]');
      const passwordHash = gate?.dataset.passwordHash;
      const storageKey = 'conscia-site-preview-unlocked';
      const compatibilityPassword = 'conscia-preview';

      if (!gate || !form || !input || !error || !content || !passwordHash) return;

      const reveal = () => {
        gate.hidden = true;
        content.hidden = false;
        content.removeAttribute('aria-hidden');
      };

      try {
        if (window.sessionStorage.getItem(storageKey) === passwordHash) reveal();
      } catch {
        // Private browsing modes can disable sessionStorage; the form still works.
      }

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        error.hidden = true;

        const enteredPassword = input.value.trim();
        let isValid = enteredPassword === compatibilityPassword;

        if (!isValid && window.crypto && window.crypto.subtle && window.TextEncoder) {
          try {
            const encodedPassword = new window.TextEncoder().encode(enteredPassword);
            const digest = await window.crypto.subtle.digest('SHA-256', encodedPassword);
            const submittedHash = Array.from(new Uint8Array(digest), (byte) => byte.toString(16).padStart(2, '0')).join('');
            isValid = submittedHash === passwordHash;
          } catch {
            // The compatibility password keeps the basic gate usable if Web Crypto is unavailable.
          }
        }

        if (!isValid) {
          error.hidden = false;
          input.select();
          return;
        }

        try {
          window.sessionStorage.setItem(storageKey, passwordHash);
        } catch {
          // The unlocked state only needs to last for this page session.
        }

        reveal();
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initialisePreviewGate, { once: true });
    } else {
      initialisePreviewGate();
    }
  })();
</script>
