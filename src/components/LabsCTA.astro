---
import Arrow from './Arrow.astro';
---

<section class="labs-cta section-dark" id="about" aria-labelledby="cta-title">
  <div class="container labs-cta__inner">
    <div class="labs-cta__copy">
      <p class="section-label">03 / About Labs</p>
      <h2 id="cta-title">Work with us<br /><span>on the hard parts.</span></h2>
      <p>We test ideas in software. Then we share what works with the people who need it.</p>
    </div>
    <div class="labs-cta__action">
      <a class="button button--outline" href="https://github.com/conscia-labs" target="_blank" rel="noreferrer">See the work on GitHub <Arrow /></a>
      <span class="labs-cta__marker" aria-hidden="true">///</span>
    </div>
  </div>
</section>
