---
const principles = [
  { number: '01', name: 'Problem first', description: 'Spend time with the people who know the problem and define what a useful result looks like.' },
  { number: '02', name: 'Make it real', description: 'Turn a promising idea into a prototype someone can try.' },
  { number: '03', name: 'Stay close', description: 'Keep the people closest to the work involved as the idea changes.' },
  { number: '04', name: 'Ship what works', description: 'Release the parts that prove dependable in day-to-day use.' },
];
---

<section class="principles" aria-labelledby="principles-title">
  <div class="container">
    <h2 class="sr-only" id="principles-title">How Conscia Labs works</h2>
    <div class="principles__grid">
      {principles.map((principle) => (
        <article class="principle">
          <span class="principle__number">{principle.number}</span>
          <h3>{principle.name}</h3>
          <p>{principle.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>
