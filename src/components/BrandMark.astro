---
interface Props {
  inverse?: boolean;
}

const { inverse = true } = Astro.props;
---

<a class:list={['brand-mark', { 'brand-mark--inverse': inverse }]} href="/" aria-label="Conscia Labs home">
  <svg class="brand-mark__icon" viewBox="0 0 32 32" aria-hidden="true">
    <path d="M16 2.5 28.2 9v14L16 30.5 3.8 23V9L16 2.5Z" fill="none" stroke="currentColor" stroke-width="1.5" />
    <path d="m3.8 9 12.2 7 12.2-7M16 16v14.5M10.1 5.6 22 12.5v7L10.1 26.4" fill="none" stroke="currentColor" stroke-width="1.2" />
  </svg>
  <span class="brand-mark__name">CONSCIA <span>LABS</span></span>
</a>
