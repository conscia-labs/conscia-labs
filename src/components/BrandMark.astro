---
import symbolBlack from '../../conscia_symbol_black.svg';
import symbolWhite from '../../conscia_symbol_white.svg';

interface Props {
  inverse?: boolean;
}

const { inverse = true } = Astro.props;
const symbol = inverse ? symbolWhite : symbolBlack;
---

<a class:list={['brand-mark', { 'brand-mark--inverse': inverse }]} href="/" aria-label="Conscia Labs home">
  <img class="brand-mark__icon" src={symbol.src} alt="" aria-hidden="true" />
  <span class="brand-mark__name">CONSCIA <span>LABS</span></span>
</a>
