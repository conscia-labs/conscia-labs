---
import { projects } from '../data/projects';
import ProjectCard from './ProjectCard.astro';
---

<section class="projects section-light" id="projects" aria-labelledby="projects-title">
  <div class="container">
    <div class="section-intro section-intro--light">
      <div>
        <p class="section-label">02 / Projects</p>
        <h2 id="projects-title">What we’re building.</h2>
      </div>
      <p>Here’s what we’re working on. These projects start with engineering problems we want to solve, and we test as we go.</p>
    </div>
    <div class="projects-grid">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </div>
</section>
