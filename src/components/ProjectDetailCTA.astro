---
import Arrow from './Arrow.astro';

interface Props {
  externalHref: string;
}

const { externalHref } = Astro.props;
---

<section class="project-detail-cta section-dark" aria-labelledby="project-cta-title">
  <div class="container project-detail-cta__inner">
    <div>
        <p class="section-label">04 / Closed beta</p>
        <h2 id="project-cta-title">Bring governed AI to your organization.</h2>
        <p>AI Gateway is currently in closed beta. Potential customers should reach out to their Conscia representative for more information.</p>
    </div>
    <a class="button button--outline" href={externalHref} target="_blank" rel="noreferrer">Open AI Gateway <Arrow /></a>
  </div>
</section>
