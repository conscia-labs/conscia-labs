---
import Arrow from './Arrow.astro';

interface Props {
  externalHref: string;
}

const { externalHref } = Astro.props;
---

<section class="project-detail-cta section-dark" aria-labelledby="project-cta-title">
  <div class="container project-detail-cta__inner">
    <div>
      <p class="section-label">04 / Start here</p>
      <h2 id="project-cta-title">Make your first request.</h2>
      <p>Open the Developer Portal to create a credential, choose an available model, and make a successful request.</p>
    </div>
    <a class="button button--outline" href={externalHref} target="_blank" rel="noreferrer">Open AI Gateway <Arrow /></a>
  </div>
</section>
