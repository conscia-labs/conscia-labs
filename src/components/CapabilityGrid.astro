---
interface CapabilityItem {
  number: string;
  title: string;
  description: string;
  accent: string;
}

interface Props {
  items: CapabilityItem[];
  id?: string;
  dark?: boolean;
  heading?: string;
  introduction?: string;
  label?: string;
}

const {
  items,
  id = 'capabilities',
  dark = true,
  label = '02 / Capabilities',
  heading = 'The pieces teams need to get started.',
  introduction = 'Model access, controls, and setup live in one place, so a team can get an idea into a working request with less friction.',
} = Astro.props;
---

<section class:list={['capability-section', { 'section-dark': dark, 'section-light': !dark }]} id={id} aria-labelledby={`${id}-title`}>
  <div class="container">
    <div class:list={['section-intro', 'capability-section__intro', { 'section-intro--dark': dark, 'section-intro--light': !dark }]}>
      <div>
        <p class="section-label">{label}</p>
        <h2 id={`${id}-title`}>{heading}</h2>
      </div>
      <p>{introduction}</p>
    </div>
    <div class="capability-grid">
      {items.map((item) => (
        <article class="capability-card" style={`--item-accent: ${item.accent}`}>
          <div class="capability-card__top">
            <span class="capability-card__number">{item.number}</span>
            <span class="capability-card__signal" aria-hidden="true"></span>
          </div>
          <h3>{item.title}</h3>
          <p>{item.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>
