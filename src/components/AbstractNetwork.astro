---
const nodes = [
  { id: 'ai', x: 145, y: 92, r: 6, kind: 'network-visual__node--hub network-visual__node--ai', ring: 17, labels: [{ text: 'AI', x: 118, y: 68 }] },
  { id: 'systems', x: 98, y: 190, r: 7, kind: 'network-visual__node--hub', ring: 20, labels: [{ text: 'SYSTEMS', x: 64, y: 160 }, { text: 'ENGINEERING', x: 64, y: 175 }] },
  { id: 'security', x: 145, y: 340, r: 6, kind: 'network-visual__node--hub', ring: 16, labels: [{ text: 'SECURITY', x: 82, y: 365 }] },
  { id: 'platforms', x: 315, y: 250, r: 8, kind: 'network-visual__node--hub', ring: 22, labels: [{ text: 'PLATFORMS', x: 315, y: 220, anchor: 'middle' }] },
  { id: 'reliability', x: 390, y: 425, r: 7, kind: 'network-visual__node--hub', ring: 19, labels: [{ text: 'RELIABILITY', x: 390, y: 470, anchor: 'middle' }] },
  { id: 'distributed', x: 485, y: 108, r: 7, kind: 'network-visual__node--hub', ring: 20, labels: [{ text: 'DISTRIBUTED', x: 454, y: 80 }, { text: 'SYSTEMS', x: 454, y: 95 }] },
  { id: 'networks', x: 565, y: 220, r: 6, kind: 'network-visual__node--hub', ring: 17, labels: [{ text: 'NETWORKS', x: 527, y: 205 }] },
  { id: 'cloud', x: 570, y: 365, r: 7, kind: 'network-visual__node--hub network-visual__node--cloud', ring: 19, labels: [{ text: 'CLOUD', x: 570, y: 398, anchor: 'middle' }] },
  { id: 'relay-top', x: 235, y: 130, r: 5, kind: 'network-visual__node--relay' },
  { id: 'relay-core', x: 410, y: 170, r: 5, kind: 'network-visual__node--relay' },
  { id: 'relay-south', x: 275, y: 390, r: 5, kind: 'network-visual__node--relay' },
  { id: 'relay-east', x: 500, y: 305, r: 5, kind: 'network-visual__node--relay' },
];

const edges = [
  ['ai', 'systems'],
  ['ai', 'relay-top'],
  ['systems', 'relay-top'],
  ['relay-top', 'platforms'],
  ['systems', 'platforms'],
  ['systems', 'security'],
  ['security', 'relay-south'],
  ['relay-south', 'platforms'],
  ['platforms', 'relay-core'],
  ['relay-core', 'distributed'],
  ['distributed', 'networks'],
  ['platforms', 'networks'],
  ['networks', 'relay-east'],
  ['relay-east', 'cloud'],
  ['platforms', 'relay-east'],
  ['cloud', 'reliability'],
  ['relay-south', 'reliability'],
  ['platforms', 'reliability'],
];

const nodeById = Object.fromEntries(nodes.map((node) => [node.id, node]));
---

<div class="network-visual" aria-hidden="true">
  <svg viewBox="0 0 680 540" role="presentation">
    <g class="network-visual__halo-rings">
      <circle cx="340" cy="260" r="226" />
      <circle cx="340" cy="260" r="142" />
    </g>
    <g class="network-visual__lines">
      {edges.map(([from, to]) => {
        const start = nodeById[from];
        const end = nodeById[to];
        return <line x1={start.x} y1={start.y} x2={end.x} y2={end.y} />;
      })}
    </g>
    <g class="network-visual__nodes">
      {nodes.map((node) => (
        <circle class={node.kind} cx={node.x} cy={node.y} r={node.r} />
      ))}
    </g>
    <g class="network-visual__rings">
      {nodes.filter((node) => node.ring).map((node) => (
        <circle cx={node.x} cy={node.y} r={node.ring} />
      ))}
    </g>
    <g class="network-visual__labels">
      {nodes.flatMap((node) => node.labels ?? []).map((label) => (
        <text x={label.x} y={label.y} text-anchor={label.anchor ?? 'start'}>{label.text}</text>
      ))}
    </g>
  </svg>
</div>
