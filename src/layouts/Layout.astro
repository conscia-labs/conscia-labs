---
import '../styles/global.css';
import PreviewGate from '../components/PreviewGate.astro';

interface Props {
  title?: string;
  description?: string;
  noIndex?: boolean;
}

const {
  title = 'Conscia Labs — Engineering what’s next',
  description = 'Conscia Labs explores, builds, and validates emerging technology across AI, networking, security, automation, and adjacent fields.',
  noIndex = true,
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const previewPasswordHash = '4bd6943e0f78937678b116a6ec5e90e404fc24c6be1194d0e6c30144340375d9';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#17191c" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex, nofollow, noarchive" />}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
  </head>
  <body>
    <div data-preview-content hidden aria-hidden="true">
      <slot />
    </div>
    <PreviewGate passwordHash={previewPasswordHash} />
  </body>
</html>
