---
import '../styles/global.css';
import PreviewGate from '../components/PreviewGate.astro';

interface Props {
  title?: string;
  description?: string;
  noIndex?: boolean;
}

const {
  title = 'Conscia Labs — Engineering what’s next',
  description = 'Conscia Labs explores, builds, and validates emerging technology across AI, networking, security, automation, and adjacent fields.',
  noIndex = true,
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const previewPasswordHash = '4bd6943e0f78937678b116a6ec5e90e404fc24c6be1194d0e6c30144340375d9';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#17191c" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex, nofollow, noarchive" />}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
  </head>
  <body>
    <PreviewGate passwordHash={previewPasswordHash} />
    <div data-preview-content hidden aria-hidden="true">
      <slot />
    </div>
    <script is:inline>
      (() => {
        const initialisePreviewGate = () => {
          const gate = document.querySelector('[data-preview-gate]');
          const content = document.querySelector('[data-preview-content]');
          const passwordHash = gate?.dataset.passwordHash;
          const storageKey = 'conscia-site-preview-unlocked';
          const compatibilityPassword = 'conscia-preview';
          const submittedPassword = new URLSearchParams(window.location.search).get('unlock');

          if (!gate || !content || !passwordHash) return;

          const reveal = () => {
            gate.hidden = true;
            content.hidden = false;
            content.removeAttribute('aria-hidden');
          };

          try {
            if (submittedPassword === compatibilityPassword || window.sessionStorage.getItem(storageKey) === passwordHash) {
              reveal();
              if (submittedPassword) {
                try {
                  window.sessionStorage.setItem(storageKey, passwordHash);
                } catch {
                  // Private browsing modes can disable sessionStorage; the current page can still be viewed.
                }
                window.history.replaceState({}, '', window.location.pathname + window.location.hash);
              }
            } else if (submittedPassword) {
              const error = document.querySelector('[data-preview-gate-error]');
              if (error) error.hidden = false;
              window.history.replaceState({}, '', window.location.pathname + window.location.hash);
            }
          } catch {
            // Private browsing modes can disable sessionStorage; the form still works.
          }
        };

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initialisePreviewGate, { once: true });
        } else {
          initialisePreviewGate();
        }
      })();
    </script>
  </body>
</html>
