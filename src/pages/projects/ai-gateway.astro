---
import CapabilityGrid from '../../components/CapabilityGrid.astro';
import Footer from '../../components/Footer.astro';
import Layout from '../../layouts/Layout.astro';
import ProjectDetailCTA from '../../components/ProjectDetailCTA.astro';
import ProjectDetailHero from '../../components/ProjectDetailHero.astro';
import { aiGatewayCapabilities, aiGatewayDifferentiators } from '../../data/ai-gateway';
---

<Layout
  title="AI Gateway — Conscia Labs"
  description="AI Gateway gives organizations one controlled route to models from several providers, with security, usage controls, and guided setup. It is currently in closed beta."
  noIndex
>
  <div class="project-page">
    <ProjectDetailHero
      name="AI Gateway"
      category="Artificial Intelligence"
      type="Platform"
      description="A secure inference gateway for models from AWS Bedrock, OpenAI, Anthropic, Google, and Conscia’s own portfolio, with controls for access and use."
      status="Currently in closed beta. Contact your Conscia representative to learn more."
      externalHref="https://console.ai.conscialabs.com"
    />

    <section class="detail-overview section-light" aria-labelledby="overview-title">
      <div class="container detail-overview__grid">
        <div>
          <p class="section-label">01 / How it works</p>
          <h2 id="overview-title">One controlled route to model access.</h2>
        </div>
        <div class="detail-overview__copy">
          <p>AI Gateway sits between your organization and the models your teams use. People can experiment and build in one place, while administrators can see who has access, how the service is used, and where responsibility sits.</p>
          <p>A team can try a model and reach a working request without starting a new security or integration project for every experiment.</p>
        </div>
      </div>
    </section>

    <CapabilityGrid items={aiGatewayCapabilities} />

    <section class="differentiators section-light" aria-labelledby="differentiators-title">
      <div class="container">
        <div class="section-intro section-intro--light">
          <div>
            <p class="section-label">03 / What sets it apart</p>
            <h2 id="differentiators-title">Controls that don’t get in the way.</h2>
          </div>
          <p>AI Gateway routes model requests and keeps the surrounding context visible: who can use a model, what they use it for, and how much it costs.</p>
        </div>
        <div class="differentiator-grid">
          {aiGatewayDifferentiators.map((item) => (
            <article class="differentiator" style={`--item-accent: ${item.accent}`}>
              <span class="differentiator__number">{item.number}</span>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="portal-preview section-dark" aria-labelledby="portal-title">
      <div class="container">
        <div class="portal-preview__intro">
          <div>
            <p class="section-label">Developer Portal</p>
            <h2 id="portal-title">Everything needed for the first request.</h2>
          </div>
          <p>Setup, available models, sandbox access, usage, alerts, limits, and quickstarts all live in the Developer Portal.</p>
        </div>
        <figure class="portal-preview__figure">
          <img src="/images/ai-gateway/developer-portal.png" alt="AI Gateway Developer Portal showing setup progress, available models, usage, and quickstart actions" loading="lazy" />
          <figcaption>Developer Portal overview</figcaption>
        </figure>
      </div>
    </section>

    <ProjectDetailCTA externalHref="https://console.ai.conscialabs.com" />
    <Footer />
  </div>
</Layout>
